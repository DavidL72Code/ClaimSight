rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isEmployee() {
      return signedIn() && request.auth.token.role == "employee";
    }

    function isManager() {
      return signedIn()
        && (request.auth.token.role == "manager" || request.auth.token.role == "admin");
    }

    function caseDoc(caseId) {
      return firestore.get(/databases/(default)/documents/cases/$(caseId));
    }

    function ownsCase(caseId) {
      return signedIn() && caseDoc(caseId).data.owner_uid == request.auth.uid;
    }

    function isAssignedEmployee(caseId) {
      return isEmployee()
        && caseDoc(caseId).data.assigned_agent.email == request.auth.token.email;
    }

    function validCustomerFile() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches(
          "(image/(jpeg|png|webp|heic)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain)"
        );
    }

    match /claim-supporting-documents/{caseId}/{fileName} {
      allow read: if ownsCase(caseId) || isAssignedEmployee(caseId) || isManager();
      allow create, update: if (ownsCase(caseId) || isAssignedEmployee(caseId) || isManager())
        && validCustomerFile();
      allow delete: if ownsCase(caseId) || isAssignedEmployee(caseId) || isManager();
    }

    match /claim-messages/{caseId}/{fileName} {
      allow read: if ownsCase(caseId) || isAssignedEmployee(caseId) || isManager();
      allow create, update: if (ownsCase(caseId) || isAssignedEmployee(caseId) || isManager())
        && validCustomerFile();
      allow delete: if ownsCase(caseId) || isAssignedEmployee(caseId) || isManager();
    }

    match /claim-reviewer-evidence/{caseId}/{fileName} {
      allow read: if isAssignedEmployee(caseId) || isManager()
        || (ownsCase(caseId) && caseDoc(caseId).data.status in ["final_review", "finalized"]);
      allow create, update: if (isAssignedEmployee(caseId) || isManager())
        && validCustomerFile();
      allow delete: if isAssignedEmployee(caseId) || isManager();
    }
  }
}
