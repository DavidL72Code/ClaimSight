rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isEmployee() {
      return signedIn() && request.auth.token.role == "employee";
    }

    function isManager() {
      return signedIn()
        && (request.auth.token.role == "manager" || request.auth.token.role == "admin");
    }

    function employeeEmail() {
      return request.auth.token.email;
    }

    function ownsCase() {
      return signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    function willOwnCreatedCase() {
      return signedIn() && request.resource.data.owner_uid == request.auth.uid;
    }

    function isAssignedEmployee() {
      return isEmployee()
        && resource.data.assigned_agent.email == employeeEmail();
    }

    function isAssignedToCase(caseId) {
      return isEmployee()
        && get(/databases/$(database)/documents/cases/$(caseId)).data.assigned_agent.email == employeeEmail();
    }

    function ownsCaseId(caseId) {
      return signedIn()
        && get(/databases/$(database)/documents/cases/$(caseId)).data.owner_uid == request.auth.uid;
    }

    function validCustomerCreate() {
      return willOwnCreatedCase()
        && request.resource.data.status == "submitted"
        && request.resource.data.status_label == "Submitted"
        && request.resource.data.report_ready == false
        && request.resource.data.review.get("reviewer_name", "") == ""
        && request.resource.data.review.get("final_action", "") == ""
        && request.resource.data.review.get("reviewed_total_cost_usd", 0) == 0;
    }

    function validCustomerDecision() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["consumer_decision"])
        || (
          resource.data.status == "final_review"
          && (
            request.resource.data.consumer_decision.decision == "accepted"
            || request.resource.data.consumer_decision.decision == "appealed"
          )
        );
    }

    function validCustomerAppeal() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["appeal"])
        || (
          resource.data.status == "final_review"
          && request.resource.data.appeal.explanation is string
          && request.resource.data.appeal.category is string
        );
    }

    function validCustomerUpdate() {
      return ownsCase()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "claim_context",
          "vehicle_type",
          "supporting_documents",
          "consumer_decision",
          "appeal",
          "updated_at",
          // set when the customer sends a message, so the adjuster's
          // notification centre can show an unread indicator
          "last_customer_message_at",
          // the customer's own read marker for the message thread, kept
          // on the case doc so read state follows the account across
          // devices. The customer cannot touch the adjuster's marker
          // (employee_thread_seen_at) or the adjuster's message stamp,
          // because this hasOnly list does not include them.
          "customer_thread_seen_at"
        ])
        && validCustomerDecision()
        && validCustomerAppeal();
    }

    // The assigned adjuster used to be allowed to change any field except
    // assigned_agent and owner_uid. That let an adjuster overwrite things
    // that belong to the customer: consumer_decision (spoofing an
    // acceptance), appeal, supporting_documents, the customer's read
    // marker, and the customer's own message stamp. The allowlist below
    // is every field the employee pages actually write — enumerated from
    // employee-dashboard.js, employee-messages.js and adjustment.js — so
    // the boundary is enforced rather than trusted.
    function validEmployeeUpdate() {
      return isAssignedEmployee()
        && request.resource.data.assigned_agent == resource.data.assigned_agent
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          // triage and workflow state
          "status",
          "status_label",
          "report_ready",
          "updated_at",
          // evidence requests back to the customer
          "requested_evidence",
          "requested_evidence_types",
          "reviewer_request_note",
          "evidence_requested_at",
          "evidence_due_at",
          "consumer_notifications",
          // the adjuster's review and estimate work
          "review",
          "reviewed_total_cost_usd",
          "estimate_line_items",
          "estimate_versions",
          "final_action",
          "reviewer_evidence",
          "ai_reasoning",
          "customer_statement",
          "claim_context",
          "vehicle_type",
          // the adjuster's own messaging fields
          "last_employee_message_at",
          "employee_thread_seen_at"
        ]);
    }

    match /cases/{caseId} {
      allow create: if validCustomerCreate() || isManager();
      allow read: if ownsCase() || isAssignedEmployee() || isManager();
      allow update: if validCustomerUpdate()
        || validEmployeeUpdate()
        || isManager();
      allow delete: if isManager();
    }

    match /case_internal/{caseId} {
      allow read, write: if isAssignedToCase(caseId) || isManager();
    }

    match /case_activity/{eventId} {
      allow read: if ownsCaseId(resource.data.case_id)
        || isAssignedToCase(resource.data.case_id)
        || isManager();
      allow create: if (
          ownsCaseId(request.resource.data.case_id)
          && request.resource.data.actor_uid == request.auth.uid
          && request.resource.data.actor_role == "customer"
          && request.resource.data.type in ["claim_submitted", "appeal_submitted", "decision_accepted", "evidence_added", "message"]
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 2000
        )
        || isAssignedToCase(request.resource.data.case_id)
        || isManager();
      allow update: if false;
      allow delete: if isManager();
    }
  }
}
