# ---------------------------------------------------------------------------
# Backend (FastAPI / Hugging Face Space)
# ---------------------------------------------------------------------------
APP_ENV=development
DEBUG=false
ENABLE_API_DOCS=true

# Gemini powers damage detection, valuation grounding, and report narration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLAIM_ASSISTANT_MODEL=gemini-3.1-flash-lite

# Segmentation provider: gemini (default) | classical | mock
SEGMENTATION_PROVIDER=gemini

# Assessment quality controls.
# The evaluator (LLM-as-judge) adds one model call per assessment; each
# self-correction retry adds one more. Disable either to cut latency and spend.
ENABLE_ASSESSMENT_EVALUATOR=true
ENABLE_ASSESSMENT_RETRY=true
MAX_ASSESSMENT_RETRIES=1
# Judging and second-pass review are text-only; default to CLAIM_ASSISTANT_MODEL.
EVALUATOR_MODEL=gemini-3.1-flash-lite
SECOND_PASS_MODEL=gemini-3.5-flash-lite

# Demo reviewer. With DEMO_MODE=true the customer's submission triggers a
# model-driven stand-in for the adjuster, which performs the review workflow
# server-side and records each step so the employee portal shows the process.
# Leave false in production: real claims must reach a real adjuster.
# Point a demo deployment at its OWN Supabase project — the reviewer writes
# employee-only fields, and a manager role can read every case in a project.
DEMO_MODE=false
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_NAME=
DEMO_REVIEW_STEP_SECONDS=
DEMO_REVIEWER_MODEL=

# Optional MobileSAM (ONNX, CPU) mask refiner layered on Gemini's boxes.
# Leave disabled unless MOBILESAM_ONNX_REPO points at real ONNX weights.
ENABLE_SAM2_ONNX=false
MOBILESAM_ONNX_REPO=
MOBILESAM_ENCODER_FILE=mobile_sam.encoder.onnx
MOBILESAM_DECODER_FILE=mobile_sam.decoder.onnx

# Optional free web-search grounding for comparable market prices (https://tavily.com).
TAVILY_API_KEY=

# /api/assess and /api/claim-assistant call is rejected with 401.
# Provide exactly one of these (JSON string, file path, or GOOGLE_APPLICATION_CREDENTIALS).

# Local case/queue store. Ephemeral on Hugging Face Spaces — the file is lost
# on every rebuild or sleep, so treat Firestore as the durable record.
# Blank means "use the default"; that holds for every setting in this file.

# Optional shared-secret gate layered on top of Supabase auth.
API_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Networking / limits
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://127.0.0.1:4173,https://your-frontend.vercel.app
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,*.hf.space
ALLOW_CORS_WILDCARD=false
# Reject /api/assess requests whose Origin/Referer isn't in ALLOWED_ORIGINS.
ENFORCE_ORIGIN=false
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=12000000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=12

# ---------------------------------------------------------------------------
# Frontend build (Vercel) — injected into dist/ by frontend/scripts/build.mjs
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://davidl72code-claimsight.hf.space
GROUNDING_MODEL=gemini-3.1-flash-lite
SUMMARY_MODEL=gemini-3.1-flash-lite
RETRY_DETECTION_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Supabase. Holds auth, claim data and attachments.
#
# URL and anon key are public by design: they identify the project and are
# compiled into the frontend bundle. The RLS policies in supabase/migrations
# decide what any request may actually see, so neither key grants access on
# its own.
#
# The service key does grant full access -- it bypasses RLS -- so it stays
# server-side only, and is used solely for administrative work: storing an
# attachment, setting a user's role. Never for answering what a user may see.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ATTACHMENT_BUCKET=claim-attachments

# Only needed on projects still signing with the legacy symmetric secret.
# Newer projects use rotating asymmetric keys, verified against the project's
# JWKS endpoint, and need nothing here.
SUPABASE_JWT_SECRET=

# How long an anonymous demo visitor and their claims are kept before the
# keepalive endpoint prunes them. 0 disables pruning.
DEMO_USER_TTL_HOURS=24
